service logger /system/bin/logcat -b all -D -f /metadata/boot_log.txt
    class main
    user root
    group root system
    disabled
    oneshot

on post-fs-data
    start logger

on early-init
    start logger

on boot
    start logger

service debug_dmesg /system/bin/sh -c "dmesg -w > /metadata/boot_dmesg.txt"
    class main
    user root
    group root system
    disabled
    oneshot

on charger
    start debug_dmesg
